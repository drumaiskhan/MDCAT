# Copy to .env at the project root. Use a NEW database for MDCAT Proffs.
DATABASE_URL=postgresql://mdcat:mdcat_local_only@127.0.0.1:5433/mdcatproffs
JWT_SECRET=replace-with-a-long-random-secret-before-running
DEFAULT_ADMIN_EMAIL=owner@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-your-own-strong-password
# First boot only. Seeds five subject areas, no questions or pricing.
MDCAT_BOOTSTRAP=1
APP_URL=http://localhost:5173,http://localhost:5174
ADMIN_APP_URL=http://localhost:5174
PUBLIC_APP_URL=http://localhost:5173
# Leave PORT unset for local npm dev; frontend defaults are 5173/5174, API 3001.
# On hosting set NODE_ENV=production and provider PORT if required.
NODE_ENV=development
# Configure SMTP/email and file storage in Admin > Settings before student signup.
# For split production frontends, set each frontend's VITE_API_BASE_URL before building.

# Development-only verified student for local login, no SMTP needed.
LOCAL_DEMO_ACCOUNT=1
LOCAL_STUDENT_EMAIL=student@localhost.test
LOCAL_STUDENT_PASSWORD=replace-with-local-student-password
