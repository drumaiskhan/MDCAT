# ============================================================================
# MDCAT API environment - set these in cPanel > Setup Node.js App > Environment variables
# (or copy this file to ".env" inside the API app folder). Never commit real values.
# Frontends (student + admin) live on Hostinger; ONLY their exact https origins go below.
# ============================================================================
NODE_ENV=production

# --- Database (PostgreSQL created in cPanel > PostgreSQL Databases; use a NEW database) ---
# The API runs on the same cPanel server as the database, so use localhost.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F ...).
DATABASE_URL=postgresql://CPANELUSER_dbuser:DB_PASSWORD@localhost:5432/CPANELUSER_mdcat
# If the server only offers a Unix socket, use instead:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/DB?host=%2Fvar%2Frun%2Fpostgresql

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
DEFAULT_ADMIN_EMAIL=YOUR_EMAIL
DEFAULT_ADMIN_PASSWORD=YOUR_STRONG_PASSWORD
# First boot only. Set to 0 after the first successful start.
MDCAT_BOOTSTRAP=1

# --- Frontend origins (Hostinger). Exact origins: https, no path, no trailing slash, no www ---
# CORS allow-list: both frontends, comma-separated.
APP_URL=https://example.com,https://admin.example.com
# Admin site only (selects the admin session cookie).
ADMIN_APP_URL=https://admin.example.com
# Student site only (used for links inside emails).
PUBLIC_APP_URL=https://example.com

# --- Reverse proxy ---
# cPanel/Passenger sits behind Apache: one proxy hop. Leave at 1.
TRUST_PROXY=1

# --- Email (or configure in Admin > Settings > Email) ---
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- File storage: Cloudinary (required for uploads, or configure in Admin) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Optional: big book PDFs (> 200 MB) stored on the cPanel disk via the PHP file bridge ---
# FILE_BRIDGE_URL=https://files.example.com/index.php
# FILE_BRIDGE_SECRET=THE_SAME_LONG_RANDOM_STRING_AS_IN_config.php

# Do NOT set PORT: cPanel/Passenger assigns it.
