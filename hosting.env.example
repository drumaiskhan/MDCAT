NODE_ENV=production
# Use a NEW database. URL-encode special characters in its password.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/NEW_DB_NAME
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
DEFAULT_ADMIN_EMAIL=YOUR_EMAIL
DEFAULT_ADMIN_PASSWORD=YOUR_STRONG_PASSWORD
APP_URL=https://your-domain.com,https://admin.your-domain.com
ADMIN_APP_URL=https://admin.your-domain.com
PUBLIC_APP_URL=https://your-domain.com
MDCAT_BOOTSTRAP=1
# Leave provider-assigned PORT alone. Otherwise API defaults to 3001.
# Configure email and file storage in Admin > Platform settings before inviting students.
